{
  "name": "still-working",
  "version": "0.1.0",
  "private": false,
  "description": "Installation-style living canvas directed by OpenAI or a local fallback; Express + Vite + TypeScript.",
  "license": "MIT",
  "keywords": [
    "generative-art",
    "openai",
    "canvas",
    "installation",
    "express",
    "vite",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hoberobin/still-working.git"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite client --host 0.0.0.0",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build client",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json",
    "test": "npm run typecheck"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
